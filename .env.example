DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_DB=tutorhub
POSTGRES_USER=tutorhub
POSTGRES_PASSWORD=tutorhub
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tutorhub:tutorhub@db:5432/tutorhub

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
ENABLE_ASYNC_NOTIFICATIONS=true
CELERY_TASK_ALWAYS_EAGER=false

AI_SERVICE_URL=http://ai_service:8001
AI_SERVICE_TIMEOUT=30
ENABLE_AI_PARENT_COMMENT=false

OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_USE_MOCK=true

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@tutorhub.local
